# Teams
# 從 Teams 網頁版 DevTools → Network → 任一 chatsvc 請求 → Authorization: Bearer <token>
# 約每 24 小時過期，需手動更新
TEAMS_TOKEN=

# Atlassian (Confluence / Jira 共用)
# https://id.atlassian.com/manage-profile/security/api-tokens
ATLASSIAN_API_TOKEN=

# Figma
# https://www.figma.com/settings → Personal access tokens
FIGMA_ACCESS_TOKEN=

# POEditor
# https://poeditor.com/account/api
POEDITOR_API_TOKEN=

# ViewSonic Stage — MVB 與 CS 共用同一組帳號（SSO）
# 用途：登入 Hub Web / ClassSwift Stage 環境（例如產樣本 quiz activity / OLF 開發）
VS_STAGE_USERNAME=
VS_STAGE_PASSWORD=
