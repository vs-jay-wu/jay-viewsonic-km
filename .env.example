# Teams
# 從 Teams 網頁版 DevTools → Network → 任一 chatsvc 請求 → Authorization: Bearer <token>
# 約每 24 小時過期，需手動更新
TEAMS_TOKEN=

# Atlassian (Confluence / Jira 共用)
# https://id.atlassian.com/manage-profile/security/api-tokens
#
# 兩個都要填。API token **不自帶身分** —— Basic auth 的帳號欄位就是 email，
# 少了它連認證都過不了（實測：Bearer <token> 回 403，Basic 用 token 當帳號回 401）。
# 而且 Jira 查詢在未認證時回「0 筆」而不是 401，看起來像沒資料，很難發現。
ATLASSIAN_API_TOKEN=
ATLASSIAN_EMAIL=

# Figma
# https://www.figma.com/settings → Personal access tokens
FIGMA_ACCESS_TOKEN=

# POEditor
# https://poeditor.com/account/api
POEDITOR_API_TOKEN=

# ViewSonic Stage — MVB 與 CS 共用同一組帳號（SSO）
# 用途：登入 Hub Web / ClassSwift Stage 環境（例如產樣本 quiz activity / OLF 開發）
VS_STAGE_USERNAME=
VS_STAGE_PASSWORD=
