# Teams
# 從 Teams 網頁版 DevTools → Network → 任一 chatsvc 請求 → Authorization: Bearer <token>
# 約每 24 小時過期，需手動更新
TEAMS_TOKEN=

# Atlassian (Confluence / Jira)
# https://id.atlassian.com/manage-profile/security/api-tokens
CONFLUENCE_API_TOKEN=
JIRA_API_TOKEN=

# Figma
# https://www.figma.com/settings → Personal access tokens
FIGMA_ACCESS_TOKEN=

# POEditor
# https://poeditor.com/account/api
POEDITOR_API_TOKEN=
