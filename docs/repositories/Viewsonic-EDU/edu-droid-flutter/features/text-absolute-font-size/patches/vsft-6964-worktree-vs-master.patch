+/// VSFT-6964 —— 「只在必要時才用 matrix 補償」的決策，以及 .iwb 路徑（Q2）。
+void _compensationPolicyTests() {
+  TextAnnotation buildAnno({required double scale, required List<String> sizes}) {
+    final anno = TextAnnotation([
+      for (final s in sizes)
+        {
+          'insert': 'A',
+          'attributes': {'size': s},
+        },
+      {'insert': '\n'},
+    ]);
+    anno.transformable.transform = Matrix4.identity()..scale(scale);
+    return anno;
+  }
+
+  group('fileGridFactor — 上限與格線一次解決', () {
+    test('已在格線上 → 倍率 1（不需要任何調整）', () {
+      expect(TextAnnotation.fileGridFactor(48.0), 1.0);
+      expect(TextAnnotation.fileGridFactor(172.0), 1.0);
+    });
+
+    test('未在格線上 → 倍率把它挪到最近偶數', () {
+      expect(TextAnnotation.fileGridFactor(25.0), closeTo(26 / 25, 1e-9));
+      expect(TextAnnotation.fileGridFactor(58.88), closeTo(58 / 58.88, 1e-9));
+    });
+
+    test('超過 mvbW 上限 → 倍率把它壓回格線內', () {
+      final f = TextAnnotation.fileGridFactor(390.0);
+      expect(390.0 * f,
+          lessThanOrEqualTo(TextAnnotation.MVBW_SAFE_MAX_FILE_FONT_SIZE));
+      expect((390.0 * f) % 2, closeTo(0, 1e-9));
+    });
+
+    test('退化輸入回 1.0（不改任何東西）', () {
+      expect(TextAnnotation.fileGridFactor(0), 1.0);
+      expect(TextAnnotation.fileGridFactor(-1), 1.0);
+      expect(TextAnnotation.fileGridFactor(double.nan), 1.0);
+    });
+  });
+
+  group('.iwb 路徑（Q2）—— 字級壓進安全區、transform 反向補償', () {
+    test('字級 × ratio 未超標時不動任何東西', () {
+      final anno = buildAnno(scale: 1.0, sizes: ['20']);
+      // 20 × 2 = 40，遠低於上限且已在格線上
+      expect(TextAnnotation.fileGridFactor(20 * 2.0), 1.0);
+    });
+
+    test('stored 130 @ dpr 3 = 390 超標 → 被壓回格線內', () {
+      final anno = buildAnno(scale: 1.0, sizes: ['130']);
+      final f = TextAnnotation.fileGridFactor(anno.maxStoredFontSize * 3.0);
+      final written = 130 * 3.0 * f;
+      expect(written,
+          lessThanOrEqualTo(TextAnnotation.MVBW_SAFE_MAX_FILE_FONT_SIZE));
+      expect(written % 2, closeTo(0, 1e-9));
+    });
+
+    test('補償後乘積守恆：字級 × (1/f) 還原成原本的視覺大小', () {
+      final f = TextAnnotation.fileGridFactor(130 * 3.0);
+      // 寫出的字級 × 補償後的 matrix scale == 原本的字級
+      expect((130 * f) * (1 / f), closeTo(130.0, 1e-9));
+    });
+  });
+
+  group('補償決策 — 只在必要時才動 matrix', () {
+    test('吸附不改變 display → 判定為「不需補償」', () {
+      // zoom=1、字級 25：吸附成 26，display 25→24 vs 26→26 會變 → 需要補償
+      // 字級 26（已在格線）：不變 → 不需補償
+      final onGrid = buildAnno(scale: 1.0, sizes: ['26']);
+      expect(TextAnnotation.fileGridFactor(onGrid.maxStoredFontSize * 1.0), 1.0);
+    });
+
+    test('多 run 取最大值當名目值', () {
+      final anno = buildAnno(scale: 1.0, sizes: ['20', '48', '130']);
+      expect(anno.maxStoredFontSize, 130.0);
+    });
+  });
+}
