diff --git a/lib/widget/dialog/text_editor/ui_v2/text_editor_size_bridge.dart b/lib/widget/dialog/text_editor/ui_v2/text_editor_size_bridge.dart
new file mode 100644
index 000000000..aaf22ff5b
--- /dev/null
+++ b/lib/widget/dialog/text_editor/ui_v2/text_editor_size_bridge.dart
@@ -0,0 +1,61 @@
+import 'package:droid/annotation_model/text_annotation.dart';
+
+/// VSFT-6964 — 邊界轉換：Quill 內的 `size` 屬性是 **stored 域**字級
+/// （= 檔案 / annotation 裡真正存的值，zoom 與 resize 一律只存在 matrix 裡，
+/// 永遠不烤進字級）。TextEditor 唯一一個跟「display value」對話的入口就是這個 bridge。
+///
+/// 這裡的「display value」= toolbar 顯示給使用者看的字級 = 「在 canvas zoom=1.0 時的
+/// 視覺字級」。**不是**使用者最初挑的數字（例如 lasso 拉大 2 倍後，原本挑 20 但 display
+/// value 是 40）—— 眼睛看到多大就顯示多少，與 PowerPoint / Slides 的行為一致。
+///
+/// ```
+/// display = stored × elementScale ÷ canvasZoom
+/// ```
+///
+/// [elementScale] 是 annotation matrix 的 scale，**已經包含 canvas zoom**
+/// （pinch zoom 會把 scale 烤進所有 annotation matrix，見 `infinite_canvas.dart`
+/// 的 `_concatenatingTransformByElement`），所以除回 [canvasZoom] 之後剩下的
+/// 才是「使用者自己拉出來的」倍率。
+///
+/// 例：zoom=1.75 新建的文字 → elementScale=1.75、canvasZoom=1.75 → factor=1
+///     → 挑 20 就存 20、toolbar 顯示 20。
+///     同一段文字被 lasso 拉大 2 倍 → elementScale=3.5 → factor=2 → toolbar 顯示 40。
+///
+/// 編輯器的「視覺放大」不再靠把 scale 烤進字級，而是由
+/// `MediaQuery(textScaler: TextScaler.linear(elementScale))` 提供
+/// （flutter_quill 10.5.5 的 `RichText` / `RichTextProxy` 都吃 textScaler，已實測）。
+class TextEditorSizeBridge {
+  TextEditorSizeBridge({
+    required double canvasZoom,
+    required double elementScale,
+  })  : _canvasZoom = _sanitize(canvasZoom),
+        _elementScale = _sanitize(elementScale);
+
+  final double _canvasZoom;
+  final double _elementScale;
+
+  static double _sanitize(double value) =>
+      (value == 0 || value.isNaN || value.isInfinite) ? 1.0 : value;
+
+  /// stored → display 的倍率。
+  double get displayFactor => _elementScale / _canvasZoom;
+
+  bool get _isIdentity => (displayFactor - 1.0).abs() < 0.0001;
+
+  /// Quill 內 stored 字級 → toolbar 顯示用的 display value（floor 到偶數 / clamp 到 [MIN, MAX]）。
+  /// 回傳 null 代表 Quill 沒有 size 屬性。
+  String? displayFromQuillSize(String? rawQuillSize) {
+    if (rawQuillSize == null) return null;
+    final double? raw = double.tryParse(rawQuillSize);
+    if (raw == null) return rawQuillSize;
+    final double displayValue = _isIdentity ? raw : raw * displayFactor;
+    return TextAnnotation.getNextLargerNumber(displayValue).toString();
+  }
+
+  /// 使用者在 toolbar 挑的 display value → 寫回 Quill 的 stored 字級。
+  /// factor ≈ 1 時維持「整數字串」的舊行為，避免在沒必要時引入 float 字串。
+  String quillSizeFromDisplay(int displaySize) {
+    if (_isIdentity) return displaySize.toString();
+    return (displaySize / displayFactor).toString();
+  }
+}
