diff --git a/test/annotation_model/text_annotation_font_size_test.dart b/test/annotation_model/text_annotation_font_size_test.dart
new file mode 100644
index 000000000..97339faf0
--- /dev/null
+++ b/test/annotation_model/text_annotation_font_size_test.dart
@@ -0,0 +1,527 @@
+import 'dart:ui' show PlatformDispatcher;
+
+import 'package:droid/annotation_model/text_annotation.dart';
+import 'package:droid/model/preference_settings/app_preference_settings.dart';
+import 'package:flutter/widgets.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:shared_preferences/shared_preferences.dart';
+
+/// VSFT-6964 — TextAnnotation 字級處理的單元測試。
+///
+/// 涵蓋三塊：
+/// 1. [TextAnnotation.getNextLargerNumber] — toolbar 顯示用的「round 後 floor
+///    到偶數 + clamp」，是既有行為的回歸保護（bridge 依賴它）。
+/// 2. [TextAnnotation.clampedPreciseSizeString] — OLF 匯入時保留小數精度、
+///    只 clamp 的序列化（round-trip 的關鍵一步）。
+/// 3. [TextAnnotation.normalizedClone] 的兩條路徑 —
+///    `convertToIntegerFontSize: true`（預設，既有呼叫點的回歸保護）與
+///    `false`（TextEditor 走的新路徑，保留精確 scaled 值）。
+///
+/// 注意：測試的 jsonList 一律讓非換行的 insert 自帶 `size` attribute，
+/// 避開沒有 size 時 fallback 到 AppPreferenceSettings singleton 的路徑
+/// （該 singleton 在測試中未初始化）。
+void main() {
+  TestWidgetsFlutterBinding.ensureInitialized();
+
+  setUpAll(() async {
+    // TextAnnotation 建構時 getDefaultStyle() 會讀 AppPreferenceSettings 的
+    // fontFamily / fontSize；testEnsureInitialized 會給這些 late 欄位
+    // in-memory 預設值（不跑 _load，避免牽入 platform channel）。
+    SharedPreferences.setMockInitialValues({});
+    await AppPreferenceSettings.testEnsureInitialized();
+  });
+
+  group('getNextLargerNumber — round 後 floor 到偶數', () {
+    test('偶數整數原樣回', () {
+      expect(TextAnnotation.getNextLargerNumber(20), 20);
+      expect(TextAnnotation.getNextLargerNumber(52), 52);
+    });
+
+    test('奇數 floor 到偶數', () {
+      expect(TextAnnotation.getNextLargerNumber(21), 20);
+      expect(TextAnnotation.getNextLargerNumber(35), 34);
+    });
+
+    test('小數先 round 再 floor 到偶數（21.6 → 22，不是 20）', () {
+      expect(TextAnnotation.getNextLargerNumber(21.6), 22);
+      expect(TextAnnotation.getNextLargerNumber(53.33), 52);
+    });
+
+    test('低於 MIN_SIZE clamp 到 MIN_SIZE', () {
+      expect(TextAnnotation.getNextLargerNumber(5), TextAnnotation.MIN_SIZE);
+      expect(TextAnnotation.getNextLargerNumber(0), TextAnnotation.MIN_SIZE);
+    });
+
+    test('高於 MAX_SIZE clamp 到 MAX_SIZE', () {
+      expect(TextAnnotation.getNextLargerNumber(999), TextAnnotation.MAX_SIZE);
+    });
+
+    test('MIN / MAX 邊界值原樣回', () {
+      expect(TextAnnotation.getNextLargerNumber(
+              TextAnnotation.MIN_SIZE.toDouble()),
+          TextAnnotation.MIN_SIZE);
+      expect(TextAnnotation.getNextLargerNumber(
+              TextAnnotation.MAX_SIZE.toDouble()),
+          TextAnnotation.MAX_SIZE);
+    });
+  });
+
+  group('toJson — OLF 存檔保留精確 scaled 字級（VSFT-6964 D1 修正）', () {
+    // toJson 內部 genParagraph 的 font-size = span 字級 × devicePixelRatio。
+    final double dpr =
+        PlatformDispatcher.instance.views.first.devicePixelRatio;
+
+    double savedFontSizeOf(TextAnnotation anno) {
+      final json = anno.toJson(dpr);
+      final blocks =
+          json['textarea']['text-blocks-container'] as List<dynamic>;
+      final textList = blocks.first['paragraph']['text-list-container']
+          as List<dynamic>;
+      return (textList.first['text']['font-size'] as num).toDouble();
+    }
+
+    TextAnnotation buildAnno({required double scale, required String size}) {
+      final anno = TextAnnotation([
+        {
+          'insert': 'Hello',
+          'attributes': {'size': size, 'color': '#ff000000', 'font': 'Roboto'},
+        },
+        {'insert': '\n'},
+      ]);
+      anno.transformable.transform = Matrix4.identity()..scale(scale);
+      return anno;
+    }
+
+    // 存檔語意（第 2 項 + 格線對齊後）：
+    //   * 檔案值 ≤ mvbW 上限、且落在偶數整數 px 格線上
+    //   * 「字級 × 殘餘 matrix scale」的乘積**完全不變** → 顯示不漂移
+    // 注意：檔案域 = annotation 域 × dpr × fileToScreenScale，
+    // 所以 dpr 越大越容易觸發上限（dpr=3 時 display 48 @ zoom1.23 就會被壓）。
+    // 測試環境取不到 canvas zoom → toJson 走「保守補償」分支，
+    // 對應的烤入倍率 = matrixScale × fileGridFactor(名目最大值)
+    double bakeOf(TextAnnotation anno) {
+      final nominal = anno.maxStoredFontSize * anno.matrixScale * dpr;
+      return anno.matrixScale * TextAnnotation.fileGridFactor(nominal);
+    }
+
+    test('存檔值落在 mvbW 偶數整數 px 格線上', () {
+      for (final size in ['20', '48', '130']) {
+        final anno = buildAnno(scale: 1.2265710829939889, size: size);
+        final fileValue = double.parse(size) * bakeOf(anno) * dpr;
+        expect(fileValue % 2, closeTo(0, 1e-6),
+            reason: 'size=$size 檔案值 $fileValue 不在偶數格線上');
+        expect(fileValue,
+            lessThanOrEqualTo(TextAnnotation.MVBW_SAFE_MAX_FILE_FONT_SIZE + 1e-6),
+            reason: 'size=$size 檔案值 $fileValue 超過 mvbW 上限');
+      }
+    });
+
+    test('乘積守恆：字級 × 殘餘 matrix scale == 原視覺大小', () {
+      const zoom = 1.2265710829939889;
+      for (final size in [20.0, 48.0, 130.0]) {
+        final anno = buildAnno(scale: zoom, size: '${size.toInt()}');
+        final bake = bakeOf(anno);
+        final savedSize = size * bake;
+        final remainingMatrixScale = anno.matrixScale / bake;
+        expect(savedSize * remainingMatrixScale, closeTo(size * zoom, 1e-6),
+            reason: 'size=$size 乘積被改變了 → 顯示會漂移');
+      }
+    });
+
+    test('round-trip：重開後 toolbar 顯示值不變（130/48/20 全案例）', () {
+      const zoom = 1.2265710829939889;
+      for (final display in [130, 48, 20]) {
+        final anno = buildAnno(scale: zoom, size: '$display');
+        final bake = bakeOf(anno);
+        // 重開：讀回 font-size 與 matrix，display = 乘積 ÷ zoom
+        final product = (display * bake) * (anno.matrixScale / bake);
+        final reopened = TextAnnotation.getNextLargerNumber(product / zoom);
+        expect(reopened, display,
+            reason: 'display $display @ zoom $zoom 應完整 round-trip');
+      }
+    });
+  });
+
+  group('normalizedClone — convertToIntegerFontSize 兩條路徑', () {
+    TextAnnotation buildAnno({required double scale, required String size}) {
+      // attributes 自帶 size / color / font，避開缺屬性時 fallback 到
+      // AppPreferenceSettings singleton 的填充路徑（測試中未初始化）。
+      final anno = TextAnnotation([
+        {
+          'insert': 'Hello',
+          'attributes': {'size': size, 'color': '#000000', 'font': 'Roboto'},
+        },
+        {'insert': '\n'},
+      ]);
+      anno.transformable.transform = Matrix4.identity()..scale(scale);
+      return anno;
+    }
+
+    String? sizeOf(TextAnnotation anno) {
+      final attrs = anno.jsonList.first['attributes'] as Map?;
+      return attrs?['size'] as String?;
+    }
+
+    test('預設（true）：scaled 字級 round 後 floor 到偶數 — 既有行為回歸保護', () {
+      final anno = buildAnno(scale: 1.75, size: '20');
+      // 不帶參數呼叫 = 既有呼叫點的行為，預設值改變會直接讓這條爆掉
+      final clone = anno.normalizedClone();
+      // 20 × 1.75 = 35 → floor 到偶數 34
+      expect(sizeOf(clone), '34');
+    });
+
+    test('false：scaled 字級保留精確 float（TextEditor 新路徑）', () {
+      final anno = buildAnno(scale: 1.75, size: '20');
+      final clone = anno.normalizedClone(convertToIntegerFontSize: false);
+      expect(sizeOf(clone), '35.0');
+    });
+
+    test('false：scale=1 時整數字串會變 float 字串（documented 行為）', () {
+      // (double.parse('20') * 1.0).toString() = '20.0'——render path 一律
+      // double.parse，視覺無差異；此測試把行為釘住避免被「順手修正」。
+      final anno = buildAnno(scale: 1.0, size: '20');
+      final clone = anno.normalizedClone(convertToIntegerFontSize: false);
+      expect(sizeOf(clone), '20.0');
+    });
+
+    test('true：scale=1 時奇數字級仍會被 floor 到偶數', () {
+      final anno = buildAnno(scale: 1.0, size: '21');
+      final clone = anno.normalizedClone();
+      expect(sizeOf(clone), '20');
+    });
+
+    test('縮小（scale=0.5）：false 保留精度、true floor 到偶數', () {
+      final annoA = buildAnno(scale: 0.5, size: '35');
+      expect(sizeOf(annoA.normalizedClone(convertToIntegerFontSize: false)),
+          '17.5');
+
+      final annoB = buildAnno(scale: 0.5, size: '35');
+      // 35 × 0.5 = 17.5 → round = 18 → 偶數 18
+      expect(sizeOf(annoB.normalizedClone()), '18');
+    });
+
+    test('兩條路徑都會把 transform 的 scale 歸一', () {
+      for (final convert in [true, false]) {
+        final anno = buildAnno(scale: 1.75, size: '20');
+        final clone =
+            anno.normalizedClone(convertToIntegerFontSize: convert);
+        final m = clone.transformable.transform;
+        // MSCALE_X / MSKEW_Y 反推 scale（normalizedClone 內的同款算法）
+        expect(m[0], closeTo(1.0, 0.0001),
+            reason: 'scale normalized (convert=$convert)');
+        expect(m[4], closeTo(0.0, 0.0001));
+      }
+    });
+
+    test('兩條路徑都會把 width 乘上 scale', () {
+      for (final convert in [true, false]) {
+        final anno = buildAnno(scale: 1.75, size: '20');
+        final originalWidth = anno.width;
+        final clone =
+            anno.normalizedClone(convertToIntegerFontSize: convert);
+        expect(clone.width, closeTo(originalWidth * 1.75, 0.0001),
+            reason: 'width scaled (convert=$convert)');
+      }
+    });
+
+    test('不會改到原本的 jsonList（undo 依賴此行為）', () {
+      final anno = buildAnno(scale: 1.75, size: '20');
+      anno.normalizedClone(convertToIntegerFontSize: false);
+      expect(sizeOf(anno), '20');
+    });
+  });
+
+  _saveNormalizationTests();
+  _fileGridTests();
+  _compensationPolicyTests();
+}
+
+/// VSFT-6964 第 2 項 —— 存檔正規化（不改 mvbW 也能跨平台相容）。
+///
+/// 「視覺 = font-size × matrix scale」兩平台一致，所以存檔時把字級壓進
+/// mvbW 的合法射程（130pt = 173.33px 檔案域）、超出的倍率留在 matrix，
+/// 視覺與語意都不變，但檔案不再會被 mvbW 的破壞性吸附改寫。
+void _saveNormalizationTests() {
+  TextAnnotation buildAnno({required double scale, required String size}) {
+    final anno = TextAnnotation([
+      {
+        'insert': 'A',
+        'attributes': {'size': size},
+      },
+      {'insert': '\n'},
+    ]);
+    anno.transformable.transform = Matrix4.identity()..scale(scale);
+    return anno;
+  }
+
+  group('safeBakeScaleForSave — 存檔正規化', () {
+    test('沒超標時完全不介入（回傳整個 matrixScale = 既有行為）', () {
+      final anno = buildAnno(scale: 2.0, size: '20');
+      // 20 × 2 = 40，遠低於 173.33
+      expect(anno.safeBakeScaleForSave(1.0), 2.0);
+    });
+
+    test('剛好貼齊上限時不介入', () {
+      final anno = buildAnno(scale: 1.0, size: '173.33');
+      expect(anno.safeBakeScaleForSave(1.0), 1.0);
+    });
+
+    test('超標時只烤到上限，剩餘倍率留在 matrix', () {
+      // 130 × 4 = 520 → 遠超 173.33
+      final anno = buildAnno(scale: 4.0, size: '130');
+      final bake = anno.safeBakeScaleForSave(1.0);
+      // 烤完的字級應該剛好是上限
+      expect(130 * bake, closeTo(TextAnnotation.MVBW_SAFE_MAX_FILE_FONT_SIZE, 0.001));
+      // 剩餘倍率 = 4 / bake，留在 matrix
+      expect(bake, lessThan(4.0));
+    });
+
+    test('視覺大小不變 —— 烤進去的 × 留在 matrix 的 = 原本的 scale', () {
+      final anno = buildAnno(scale: 4.0, size: '130');
+      final bake = anno.safeBakeScaleForSave(1.0);
+      final clone = anno.normalizedClone(
+          convertToIntegerFontSize: false, bakeScaleOverride: bake);
+      final storedSize = double.parse(
+          (clone.jsonList.first['attributes'] as Map)['size'] as String);
+      // 字級 × 殘餘 matrix scale == 原本的視覺大小 130 × 4
+      expect(storedSize * clone.matrixScale, closeTo(130 * 4.0, 0.001));
+    });
+
+    test('正規化後的字級必定 ≤ mvbW 上限', () {
+      for (final scale in [1.0, 2.0, 4.0, 10.0]) {
+        for (final size in ['10', '20', '130']) {
+          final anno = buildAnno(scale: scale, size: size);
+          final bake = anno.safeBakeScaleForSave(1.0);
+          final clone = anno.normalizedClone(
+              convertToIntegerFontSize: false, bakeScaleOverride: bake);
+          final storedSize = double.parse(
+              (clone.jsonList.first['attributes'] as Map)['size'] as String);
+          expect(storedSize,
+              lessThanOrEqualTo(TextAnnotation.MVBW_SAFE_MAX_FILE_FONT_SIZE + 0.001),
+              reason: 'scale=$scale size=$size 存檔後仍超標');
+        }
+      }
+    });
+
+    test('fileScale 會被算進去（存檔時字級還會再被乘一次）', () {
+      final anno = buildAnno(scale: 1.0, size: '130');
+      // fileScale=2 → 檔案值 = 130 × 2 = 260 > 173.33 → 必須介入
+      final bake = anno.safeBakeScaleForSave(2.0);
+      expect(bake, lessThan(1.0));
+      final clone = anno.normalizedClone(
+          convertToIntegerFontSize: false, bakeScaleOverride: bake);
+      final storedSize = double.parse(
+          (clone.jsonList.first['attributes'] as Map)['size'] as String);
+      expect(storedSize * 2.0,
+          closeTo(TextAnnotation.MVBW_SAFE_MAX_FILE_FONT_SIZE, 0.001));
+    });
+
+    test('退化輸入不炸：scale=0 / NaN / fileScale=0', () {
+      final zero = buildAnno(scale: 0.0, size: '20');
+      expect(zero.safeBakeScaleForSave(1.0), 0.0);
+      final normal = buildAnno(scale: 2.0, size: '20');
+      expect(normal.safeBakeScaleForSave(0.0), 2.0);
+      expect(normal.safeBakeScaleForSave(double.nan), 2.0);
+    });
+  });
+
+  group('normalizedClone — bakeMatrixScale: false（TextScaler 路徑）', () {
+    test('字級不被乘 scale、matrix scale 原封不動', () {
+      final anno = buildAnno(scale: 1.75, size: '20');
+      final clone = anno.normalizedClone(
+          convertToIntegerFontSize: false, bakeMatrixScale: false);
+      expect(
+          double.parse(
+              (clone.jsonList.first['attributes'] as Map)['size'] as String),
+          20.0);
+      expect(clone.matrixScale, closeTo(1.75, 0.0001));
+    });
+
+    test('預設路徑仍把 matrix scale 歸 1（既有行為回歸保護）', () {
+      final anno = buildAnno(scale: 1.75, size: '20');
+      final clone = anno.normalizedClone(convertToIntegerFontSize: false);
+      expect(clone.matrixScale, closeTo(1.0, 0.0001));
+    });
+  });
