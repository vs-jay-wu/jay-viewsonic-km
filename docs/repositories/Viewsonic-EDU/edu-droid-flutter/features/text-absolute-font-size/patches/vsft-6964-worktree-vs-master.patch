+/// VSFT-6964 —— mvbW 安全格線（偶數整數 px）＋ sticky note invariant。
+///
+/// 目的：讓 mvbW 的 `Math.Round` 與 RTF 半點量化變成 no-op，
+/// 使「第 5 項（mvbW 端修正）」不再是本票的前提條件。
+void _fileGridTests() {
+  group('snapToFileGrid — mvbW 安全格線', () {
+    test('已在格線上的值不動（idempotent）', () {
+      for (final v in [10.0, 24.0, 48.0, 130.0, 172.0]) {
+        expect(TextAnnotation.snapToFileGrid(v), v, reason: '$v 應原地不動');
+        expect(TextAnnotation.snapToFileGrid(TextAnnotation.snapToFileGrid(v)), v,
+            reason: '$v 反覆吸附不應漂移');
+      }
+    });
+
+    test('奇數 / 小數吸附到最近的偶數', () {
+      expect(TextAnnotation.snapToFileGrid(25.0), 26.0);
+      expect(TextAnnotation.snapToFileGrid(24.53), 24.0);
+      expect(TextAnnotation.snapToFileGrid(58.88), 58.0);
+      expect(TextAnnotation.snapToFileGrid(27.4), 28.0);
+    });
+
+    test('吸附後的 pt 一定是 0.5 的倍數（RTF 半點可表示）', () {
+      for (var raw = 1.0; raw < 200; raw += 0.37) {
+        final px = TextAnnotation.snapToFileGrid(raw);
+        final pt = px * 0.75;
+        expect((pt * 2) % 1, closeTo(0, 1e-9),
+            reason: 'px=$px → pt=$pt 不是半點的倍數');
+      }
+    });
+
+    test('吸附後的 px 一定是整數（mvbW Math.Round 變 no-op）', () {
+      for (var raw = 1.0; raw < 200; raw += 0.37) {
+        final px = TextAnnotation.snapToFileGrid(raw);
+        expect(px % 1, 0, reason: 'px=$px 不是整數');
+      }
+    });
+
+    test('吸附不會把貼齊上限的值推過頭', () {
+      final snapped =
+          TextAnnotation.snapToFileGrid(TextAnnotation.MVBW_SAFE_MAX_FILE_FONT_SIZE);
+      expect(snapped, lessThanOrEqualTo(TextAnnotation.MVBW_SAFE_MAX_FILE_FONT_SIZE));
+      expect(snapped, 172.0);
+    });
+
+    test('吸附誤差不超過 1 px（檔案域）', () {
+      for (var raw = 4.0; raw < 170; raw += 0.13) {
+        final px = TextAnnotation.snapToFileGrid(raw);
+        expect((px - raw).abs(), lessThanOrEqualTo(1.0 + 1e-9),
+            reason: 'raw=$raw → $px 偏差過大');
+      }
+    });
+
+    test('退化輸入不炸', () {
+      expect(TextAnnotation.snapToFileGrid(0), 0);
+      expect(TextAnnotation.snapToFileGrid(-5), -5);
+      expect(TextAnnotation.snapToFileGrid(double.nan).isNaN, isTrue);
+    });
+  });
+
+  group('sticky note invariant（Q5）', () {
+    // stickynote_annotation.dart:223 / :316-329 取的是內層 text 的**原始 size 屬性**，
+    // 完全不看內層 matrix；element_helper.dart:1453 讀回來也只還原純量。
+    // 也就是說 sticky note 會「吃掉」內層 text 的 matrix scale。
+    //
+    // 目前安全是因為內層 text 的 matrix 恆為 identity（它被移出 pageData.annotations，
+    // pinch zoom 不會把 scale 烤進它）。這條測試把那個前提釘住 ——
+    // 一旦有人讓內層 text 帶 scale，就會在這裡爆掉，而不是變成使用者才看得到的縮放 bug。
+    test('內層 text 帶 scale 時，純量字級會漏掉倍率（記錄現況，非期望行為）', () {
+      final text = TextAnnotation([
+        {
+          'insert': 'A',
+          'attributes': {'size': '20'},
+        },
+        {'insert': '\n'},
+      ]);
+      text.transformable.transform = Matrix4.identity()..scale(2.0);
+
+      // 原始 size 屬性完全沒有反映 matrix 的 2 倍
+      final rawSize =
+          (text.jsonList.first['attributes'] as Map)['size'] as String;
+      expect(rawSize, '20');
+      expect(text.matrixScale, closeTo(2.0, 1e-9));
+
+      // → 視覺是 40，但 sticky note 只會存 20。這就是「matrix 救不回來」的路徑。
+      expect(double.parse(rawSize) * text.matrixScale, closeTo(40.0, 1e-9));
+    });
+
+    test('不帶 scale 時純量字級即為視覺字級（sticky note 依賴的前提）', () {
+      final text = TextAnnotation([
+        {
+          'insert': 'A',
+          'attributes': {'size': '20'},
+        },
+        {'insert': '\n'},
+      ]);
+      expect(text.matrixScale, closeTo(1.0, 1e-9));
+      final rawSize =
+          (text.jsonList.first['attributes'] as Map)['size'] as String;
+      expect(double.parse(rawSize) * text.matrixScale, closeTo(20.0, 1e-9));
+    });
+  });
+}
