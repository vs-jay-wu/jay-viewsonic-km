+import 'package:droid/annotation_model/text_annotation.dart';
+import 'package:droid/widget/dialog/text_editor/ui_v2/text_editor_size_bridge.dart';
+import 'package:flutter_test/flutter_test.dart';
+
+/// VSFT-6964：bridge 的語意在「編輯器改用 TextScaler」之後改變 ——
+/// Quill 內從「baked scaled 值」變成 **stored 域**字級。
+///
+///   display = stored × elementScale ÷ canvasZoom
+///
+/// elementScale 是 annotation matrix 的 scale，**已含 canvas zoom**
+/// （pinch zoom 會把 scale 烤進 annotation matrix），所以：
+///   * 單純 zoom（沒 resize 過）→ elementScale == canvasZoom → factor = 1
+///   * lasso 拉大 k 倍 → elementScale == canvasZoom × k → factor = k
+void main() {
+  group('factor = 1（純 zoom，沒被 resize 過）', () {
+    // zoom 1.75 建立 / 開啟的文字：matrix scale 也是 1.75 → factor = 1
+    final bridge =
+        TextEditorSizeBridge(canvasZoom: 1.75, elementScale: 1.75);
+
+    test('stored 字級原樣顯示 —— 這就是本票的核心目標', () {
+      expect(bridge.displayFromQuillSize('20'), '20');
+      expect(bridge.displayFromQuillSize('130'), '130');
+    });
+
+    test('quillSizeFromDisplay 不再乘 zoom，直接存 display value', () {
+      expect(bridge.quillSizeFromDisplay(20), '20');
+      expect(bridge.quillSizeFromDisplay(22), '22');
+    });
+
+    test('任何 zoom 下 stored=20 都顯示 20（zoom 不再汙染字級）', () {
+      for (final zoom in [0.1, 0.75, 0.9, 1.0, 1.75, 4.0]) {
+        final b = TextEditorSizeBridge(canvasZoom: zoom, elementScale: zoom);
+        expect(b.displayFromQuillSize('20'), '20',
+            reason: 'zoom=$zoom 時 stored=20 應顯示 20');
+      }
+    });
+  });
+
+  group('factor ≠ 1（lasso resize 後）', () {
+    test('zoom=1.0、lasso 2x：stored 20 顯示 40', () {
+      final bridge =
+          TextEditorSizeBridge(canvasZoom: 1.0, elementScale: 2.0);
+      expect(bridge.displayFromQuillSize('20'), '40');
+    });
+
+    test('zoom=1.0、lasso 0.5x：stored 20 顯示 10', () {
+      final bridge =
+          TextEditorSizeBridge(canvasZoom: 1.0, elementScale: 0.5);
+      expect(bridge.displayFromQuillSize('20'), '10');
+    });
+
+    test('zoom=1.75、lasso 2x：elementScale=3.5 → 仍顯示 40（zoom 被除掉）', () {
+      final bridge =
+          TextEditorSizeBridge(canvasZoom: 1.75, elementScale: 3.5);
+      expect(bridge.displayFromQuillSize('20'), '40');
+    });
+
+    test('挑 display value 會反算回 stored（除以 factor）', () {
+      final bridge =
+          TextEditorSizeBridge(canvasZoom: 1.0, elementScale: 2.0);
+      expect(bridge.quillSizeFromDisplay(40), '20.0');
+    });
+
+    test('round-trip：挑 N → 寫回 → 讀回顯示應為 N', () {
+      final bridge =
+          TextEditorSizeBridge(canvasZoom: 1.75, elementScale: 3.5);
+      for (final n in [10, 12, 20, 22, 38, 64, 128, 130]) {
+        final stored = bridge.quillSizeFromDisplay(n);
+        expect(bridge.displayFromQuillSize(stored), n.toString(),
+            reason: 'round-trip for display=$n at factor=2');
+      }
+    });
+  });
+
+  group('clamp 只發生在顯示域', () {
+    test('低於 MIN_SIZE clamp 到 MIN_SIZE', () {
+      final bridge =
+          TextEditorSizeBridge(canvasZoom: 1.0, elementScale: 1.0);
+      expect(bridge.displayFromQuillSize('5'),
+          TextAnnotation.MIN_SIZE.toString());
+    });
+
+    test('高於 MAX_SIZE clamp 到 MAX_SIZE', () {
+      final bridge =
+          TextEditorSizeBridge(canvasZoom: 1.0, elementScale: 1.0);
+      expect(bridge.displayFromQuillSize('999'),
+          TextAnnotation.MAX_SIZE.toString());
+    });
+
+    test('顯示被 clamp 不代表 stored 被改 —— stored 130 × 4x 仍原樣存在', () {
+      final bridge =
+          TextEditorSizeBridge(canvasZoom: 1.0, elementScale: 4.0);
+      // 顯示端吸附到 130（清單上限），但這只是 UI 呈現
+      expect(bridge.displayFromQuillSize('130'),
+          TextAnnotation.MAX_SIZE.toString());
+      // factor 本身沒有被 clamp
+      expect(bridge.displayFactor, 4.0);
+    });
+
+    test('odd 字級 floor 到偶數', () {
+      final bridge =
+          TextEditorSizeBridge(canvasZoom: 1.0, elementScale: 1.0);
+      expect(bridge.displayFromQuillSize('21'), '20');
+      expect(bridge.displayFromQuillSize('23'), '22');
+    });
+  });
+
+  group('edge cases', () {
+    test('canvasZoom = 0 fallback 為 1.0（避免除以零）', () {
+      final bridge =
+          TextEditorSizeBridge(canvasZoom: 0.0, elementScale: 1.0);
+      expect(bridge.quillSizeFromDisplay(20), '20');
+      expect(bridge.displayFromQuillSize('20'), '20');
+    });
+
+    test('elementScale = 0 fallback 為 1.0（退化矩陣）', () {
+      final bridge =
+          TextEditorSizeBridge(canvasZoom: 1.0, elementScale: 0.0);
+      expect(bridge.displayFromQuillSize('20'), '20');
+    });
+
+    test('NaN / Infinity 都 fallback 為 1.0', () {
+      final nan =
+          TextEditorSizeBridge(canvasZoom: double.nan, elementScale: double.nan);
+      expect(nan.displayFromQuillSize('20'), '20');
+      final inf = TextEditorSizeBridge(
+          canvasZoom: double.infinity, elementScale: double.infinity);
+      expect(inf.displayFromQuillSize('20'), '20');
+    });
+
+    test('displayFromQuillSize 對 null 回 null', () {
+      final bridge =
+          TextEditorSizeBridge(canvasZoom: 1.75, elementScale: 1.75);
+      expect(bridge.displayFromQuillSize(null), isNull);
+    });
+
+    test('displayFromQuillSize 對無法解析的字串原樣回（避免炸）', () {
+      final bridge =
+          TextEditorSizeBridge(canvasZoom: 1.75, elementScale: 1.75);
+      expect(bridge.displayFromQuillSize('not-a-number'), 'not-a-number');
+    });
+  });
+
+  group('VSFT-6964 使用者重現步驟', () {
+    // 1. zoom=1.0 放 fontSize=20 文字 → 存檔
+    // 2. zoom → 1.75，再點文字進入編輯模式
+    // 3. 預期 toolbar 顯示 20
+    test('zoom 變 1.75 後開啟編輯，toolbar 顯示 20', () {
+      // pinch zoom 把 1.75 烤進 annotation matrix → elementScale = 1.75
+      final bridge =
+          TextEditorSizeBridge(canvasZoom: 1.75, elementScale: 1.75);
+      expect(bridge.displayFromQuillSize('20'), '20');
+    });
+
+    test('關閉後再開啟仍顯示 20（stored 從頭到尾沒被改過）', () {
+      final bridge =
+          TextEditorSizeBridge(canvasZoom: 1.75, elementScale: 1.75);
+      expect(bridge.displayFromQuillSize('20'), '20');
+    });
+  });
+}
