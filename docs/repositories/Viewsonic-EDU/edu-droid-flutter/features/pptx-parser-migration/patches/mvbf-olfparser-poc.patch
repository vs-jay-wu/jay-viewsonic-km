diff --git a/lib/helper/olf_file/olfparser_ffi.dart b/lib/helper/olf_file/olfparser_ffi.dart
new file mode 100644
index 000000000..3dbe4b1c1
--- /dev/null
+++ b/lib/helper/olf_file/olfparser_ffi.dart
@@ -0,0 +1,109 @@
+import 'dart:ffi';
+import 'dart:isolate';
+import 'dart:io';
+
+import 'package:ffi/ffi.dart';
+
+/// POC：olfparser（`olf-ffi` crate）的 Dart FFI 綁定，用來取代 mvbx_pptx_olf_api
+/// 的 PPTX → OLF 轉檔。輸出是 legacy OLF（不是 v-next），所以 OlfReader 不需要改。
+///
+/// ⚠️ 隱性依賴，型別上看不出來：
+///   - Android 依賴 `android/app/src/main/jniLibs/<abi>/lib_olfparser.so` 存在；
+///     缺檔會在 `DynamicLibrary.open` 丟 ArgumentError，而不是編譯期錯誤。
+///   - iOS 依賴 `lib_olfparser.a` 被靜態連進 Runner（見 ios/Flutter/*.xcconfig 的
+///     OTHER_LDFLAGS），所以查表走 `DynamicLibrary.process()`。連結旗標掉了的話，
+///     失敗點會是 `lookup` 丟 ArgumentError。
+///
+/// 與舊 parser 的差異：olfparser 自己讀 .pptx 這個 zip，呼叫端**不需要**先解壓縮。
+class OlfParserFfi {
+  static DynamicLibrary? _lib;
+
+  static DynamicLibrary _open() {
+    if (_lib != null) return _lib!;
+    if (Platform.isAndroid) {
+      _lib = DynamicLibrary.open('lib_olfparser.so');
+    } else if (Platform.isIOS) {
+      _lib = DynamicLibrary.process();
+    } else if (Platform.isMacOS) {
+      _lib = DynamicLibrary.open('lib_olfparser.dylib');
+    } else {
+      throw UnsupportedError('olfparser POC 只接了 Android / iOS / macOS');
+    }
+    return _lib!;
+  }
+
+  static bool get isAvailable {
+    try {
+      _open().lookup<NativeFunction<_Pptx2OlfNative>>('pptx2olf');
+      return true;
+    } catch (_) {
+      return false;
+    }
+  }
+
+  static String version() {
+    final fn = _open()
+        .lookup<NativeFunction<Pointer<Utf8> Function()>>('olfparser_version')
+        .asFunction<Pointer<Utf8> Function()>();
+    return fn().toDartString();
+  }
+
+  /// 轉檔並回傳 native 回報的物件數。失敗時丟 [OlfParserFfiException]。
+  static int convertPptxToOlf(String pptxPath, String olfPath) {
+    final fn = _open()
+        .lookup<NativeFunction<_Pptx2OlfNative>>('pptx2olf')
+        .asFunction<_Pptx2OlfDart>();
+
+    final inPtr = pptxPath.toNativeUtf8();
+    final outPtr = olfPath.toNativeUtf8();
+    final countPtr = calloc<Int32>();
+    try {
+      final code = fn(inPtr, outPtr, countPtr);
+      if (code != 0) {
+        throw OlfParserFfiException(code, _lastError());
+      }
+      return countPtr.value;
+    } finally {
+      calloc.free(inPtr);
+      calloc.free(outPtr);
+      calloc.free(countPtr);
+    }
+  }
+
+  static String _lastError() {
+    try {
+      final fn = _open()
+          .lookup<NativeFunction<Pointer<Utf8> Function()>>(
+              'olfparser_last_error')
+          .asFunction<Pointer<Utf8> Function()>();
+      final p = fn();
+      return p == nullptr ? '' : p.toDartString();
+    } catch (_) {
+      return '';
+    }
+  }
+}
+
+class OlfParserFfiException implements Exception {
+  OlfParserFfiException(this.code, this.message);
+
+  final int code;
+  final String message;
+
+  @override
+  String toString() => 'OlfParserFfiException(code: $code, message: $message)';
+}
+
+typedef _Pptx2OlfNative = Int32 Function(
+    Pointer<Utf8> pptxPath, Pointer<Utf8> olfPath, Pointer<Int32> objectCount);
+typedef _Pptx2OlfDart = int Function(
+    Pointer<Utf8> pptxPath, Pointer<Utf8> olfPath, Pointer<Int32> objectCount);
+
+/// 在背景 isolate 執行轉檔。
+///
+/// ⚠️ 必須是**頂層函式**：`Isolate.run` 的 closure 會捕捉整個語彙環境，寫在
+/// `_convertPptxToOlf` 內部時會把同一個 scope 的 `Completer` 一起帶進去，執行期
+/// 丟 `Illegal argument in isolate message: object is unsendable`（實測於 IFP34）。
+/// 這裡的 closure 只看得到兩個 String 參數，都是可傳送的。
+Future<int> convertPptxToOlfInIsolate(String pptxPath, String olfPath) =>
+    Isolate.run(() => OlfParserFfi.convertPptxToOlf(pptxPath, olfPath));
