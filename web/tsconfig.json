{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"],
      // av-streaming 是掛在同一個 Next app 裡的**另一套系統**（見 app/(av)/layout.tsx）。
      // 它原本是獨立專案、`@/` 指到自己的 src/，跟 km 的 `@/` 會撞，所以分一個別名。
      // 也順便當成邊界：看到 `@av/` 就知道這是 av 那邊的東西。
      "@av/*": ["./av/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}
